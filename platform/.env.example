# Copy to .env on the server. Never commit .env.
PORT=8080
PUBLIC_ORIGIN=https://infiante360techacademy.com
DATABASE_URL=postgres://user:password@localhost:5432/infinite360
ADMIN_API_KEY=change-me-long-random
SESSION_SECRET=change-me-long-random
# Webinar.gg (per the vendor docs you supplied; confirm endpoints with the vendor)
WEBINAR_GG_API_TOKEN=
WEBINAR_GG_API_BASE=https://webinar-api.webinar.gg/api/v1
# AI assistant (server-side only). Set the model id that exists on YOUR account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional integrations (placeholders only; set real values in the host secret store, never in Git)
OPENAI_API_KEY=your_api_key_here
IMAGE_PROVIDER_API_KEY=your_api_key_here
GOOGLE_ANALYTICS_ID=your_measurement_id_here
CRM_API_KEY=your_api_key_here
INDEXNOW_KEY=your_indexnow_key_here
